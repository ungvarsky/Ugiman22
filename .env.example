DATABASE_URL="postgresql://user:password@localhost:5432/hana_invoice_approval"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional SMTP config for email notifications. If unset, emails are skipped
# and only in-app notifications are created.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hana Trans Invoice Approval <no-reply@hana-trans.sk>"

# Optional: enables the "fill from photo" OCR button on the new invoice form
# (reads vendor/amount/date off an uploaded photo via Claude). If unset, the
# button is hidden and invoices must be filled in manually.
ANTHROPIC_API_KEY=

# Required in production (e.g. Vercel): invoice attachments are stored here
# instead of the local filesystem, since serverless deployments don't have a
# writable/persistent disk. Enable "Blob" storage on the Vercel project and
# this is set automatically. Safe to leave unset for local development —
# uploads then fall back to public/uploads on disk.
BLOB_READ_WRITE_TOKEN=
